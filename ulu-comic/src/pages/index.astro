.composer input{flex:1;min-width:0;font:inherit;font-weight:600;border:3px solid var(--key);padding:10px 14px;background:#fff;color:var(--key)}
@media (max-width:700px){.playpanel{grid-template-columns:1fr 1fr}.sendburst{display:none}.actor .kid{width:min(150px,100%)}.pb{font-size:.92rem}.composer{flex-direction:column}}

/* power-ups */
.powers{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.power{border:var(--line) solid var(--key);padding:22px;background:#fff;box-shadow:8px 8px 0 var(--cyan);display:grid;gap:8px;align-content:start}
.power:nth-child(2){box-shadow:8px 8px 0 var(--mag)}.power:nth-child(3){box-shadow:8px 8px 0 var(--yel)}.power:nth-child(4){box-shadow:8px 8px 0 var(--key)}
.power svg{width:64px;height:64px}
.power h3{font-family:var(--display);font-weight:400;font-size:1.3rem;line-height:1.1}
@media (max-width:980px){.powers{grid-template-columns:1fr 1fr}}
@media (max-width:520px){.powers{grid-template-columns:1fr}}

/* letters */
.letters{columns:3 300px;column-gap:28px;column-rule:3px solid var(--key)}
.letter{break-inside:avoid;padding:0 0 22px;margin-bottom:22px;border-bottom:2px dashed var(--key)}
.letter .q{font-style:italic;font-weight:600;font-size:1.08rem}
.letter .who{font-family:var(--mono);font-size:.8rem;margin:6px 0 10px;text-transform:uppercase}
.letter .a b{background:var(--yel);padding:0 4px;font-family:var(--mono);font-size:.82rem}

/* coupon */
.coupon{position:relative;border:4px dashed var(--key);padding:36px;display:grid;grid-template-columns:1.4fr 1fr;gap:30px;align-items:center;background:#fff}
.coupon::before{content:"";position:absolute;inset:10px;border:2px solid var(--key);pointer-events:none}
.scissors{position:absolute;top:-22px;left:40px;font-size:2rem;background:#fff;padding:0 6px;line-height:1}
.send-no{display:inline-block;font-family:var(--display);color:#fff;background:var(--red);padding:4px 12px;transform:rotate(-3deg);text-transform:uppercase;border:3px solid var(--key)}
.coupon h2{font-family:var(--display);font-weight:400;font-size:clamp(2rem,4.5vw,3.2rem);line-height:1;margin:14px 0 10px;text-wrap:balance}
.clip{display:grid;gap:10px;margin-top:20px;max-width:440px;position:relative;z-index:1}
.clip>label:first-child{font-family:var(--mono);font-size:.8rem;text-transform:uppercase;font-weight:700}
.clip input[type=email]{font:inherit;font-size:1.1rem;border:0;border-bottom:3px solid var(--key);padding:6px 2px;background:transparent;color:var(--key)}
.tick{display:flex;gap:10px;align-items:center;font-weight:600}
.tick input{width:20px;height:20px;accent-color:var(--key)}
.clip .stamp{justify-self:start;margin-top:8px}
.form-msg{font-weight:800;min-height:1.5em}
.coupon-art{position:relative;display:grid;place-items:center}
.coupon-ulu{width:min(260px,80%);filter:drop-shadow(8px 8px 0 var(--key))}
.freeb{position:absolute;top:-10px;right:0;z-index:2}
@media (max-width:800px){.coupon{grid-template-columns:1fr;padding:28px 20px}.coupon-art{order:-1}.coupon-ulu{width:170px}}

/* back cover */
.back{margin-top:110px;background:var(--key);color:#fff;text-align:center;padding:70px max(16px,env(safe-area-inset-right,0px)) 40px max(16px,env(safe-area-inset-left,0px))}
.tbc{font-family:var(--display);font-size:clamp(2.4rem,8vw,5.5rem);line-height:1;color:var(--yel);transform:rotate(-2deg)}
.tbc-sub{font-style:italic;font-size:1.3rem;margin-top:10px}
.foot-nav{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 20px;margin:34px 0 20px;font-family:var(--mono);text-transform:uppercase;font-size:.85rem}
.foot-nav a{text-decoration:none}.foot-nav a:hover{color:var(--yel);text-decoration:underline}
.legal{font-family:var(--mono);font-size:.75rem;opacity:.7}
.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));translate:-50% 180px;visibility:hidden;z-index:90;background:var(--yel);color:var(--key);border:3px solid var(--key);box-shadow:5px 5px 0 var(--key);padding:10px 18px;font-weight:800;transition:translate .35s cubic-bezier(.3,1.6,.5,1);max-width:calc(100vw - 32px)}
.toast.show{translate:-50% 0;visibility:visible}
</style>
