---
/** Speech / shout / thought balloon. `tail` = where the pointer sits. */
interface Props { kind?: 'speech' | 'shout' | 'thought' | 'caption'; tail?: 'bl' | 'br' | 'tl' | 'tr' | 'none'; class?: string; style?: string }
const { kind = 'speech', tail = 'bl', class: cls = '', style = '' } = Astro.props;
---
<div class={`bal bal-${kind} tail-${tail} ${cls}`} style={style}><span class="in"><slot /></span></div>

<style>
.bal{position:relative;font-family:var(--hand);font-weight:600;font-size:1.05rem;line-height:1.3;color:var(--key);text-align:center;width:max-content;max-width:100%;z-index:2}
.bal-speech{background:#fff;border:3px solid var(--key);border-radius:50%/50%;padding:.9em 1.3em}
.bal-speech::after,.bal-speech::before{content:"";position:absolute;width:0;height:0}
.tail-bl.bal-speech::before{left:22%;bottom:-24px;border-left:12px solid transparent;border-right:14px solid transparent;border-top:26px solid var(--key);transform:skewX(-24deg)}
.tail-bl.bal-speech::after{left:calc(22% + 3px);bottom:-17px;border-left:9px solid transparent;border-right:10px solid transparent;border-top:20px solid #fff;transform:skewX(-24deg)}
.tail-br.bal-speech::before{right:22%;bottom:-24px;border-left:14px solid transparent;border-right:12px solid transparent;border-top:26px solid var(--key);transform:skewX(24deg)}
.tail-br.bal-speech::after{right:calc(22% + 3px);bottom:-17px;border-left:10px solid transparent;border-right:9px solid transparent;border-top:20px solid #fff;transform:skewX(24deg)}
.tail-tl.bal-speech::before{left:24%;top:-24px;border-left:12px solid transparent;border-right:14px solid transparent;border-bottom:26px solid var(--key);transform:skewX(24deg)}
.tail-tl.bal-speech::after{left:calc(24% + 3px);top:-17px;border-left:9px solid transparent;border-right:10px solid transparent;border-bottom:20px solid #fff;transform:skewX(24deg)}
.tail-tr.bal-speech::before{right:24%;top:-24px;border-left:14px solid transparent;border-right:12px solid transparent;border-bottom:26px solid var(--key);transform:skewX(-24deg)}
.tail-tr.bal-speech::after{right:calc(24% + 3px);top:-17px;border-left:10px solid transparent;border-right:9px solid transparent;border-bottom:20px solid #fff;transform:skewX(-24deg)}
.bal .in{display:contents}
.bal-shout{filter:drop-shadow(3px 0 0 var(--key)) drop-shadow(-3px 0 0 var(--key)) drop-shadow(0 3px 0 var(--key)) drop-shadow(0 -3px 0 var(--key)) drop-shadow(4px 5px 0 var(--key))}
.bal-shout .in{display:block;background:var(--yel);padding:1.3em 1.7em;font-family:var(--display);font-weight:400;letter-spacing:.02em;
  clip-path:polygon(0% 18%,10% 22%,8% 0%,24% 14%,34% 2%,44% 14%,56% 0%,64% 14%,78% 2%,82% 18%,100% 10%,92% 34%,100% 50%,92% 62%,100% 84%,82% 80%,80% 100%,64% 86%,52% 100%,42% 86%,28% 100%,22% 84%,4% 96%,8% 72%,0% 56%,8% 42%)}
.bal-thought{background:#fff;border:3px solid var(--key);border-radius:46% 54% 50% 50%/60% 50% 50% 40%;padding:1em 1.4em;font-style:italic}
.bal-thought::before,.bal-thought::after{content:"";position:absolute;background:#fff;border:3px solid var(--key);border-radius:50%}
.bal-thought::before{width:20px;height:20px;bottom:-22px;left:24%}
.bal-thought::after{width:11px;height:11px;bottom:-38px;left:18%}
.bal-caption{background:var(--yel);border:3px solid var(--key);border-radius:0;padding:.45em .8em;font-family:var(--mono);font-weight:700;font-size:.82rem;text-transform:uppercase;letter-spacing:.04em;text-align:start;box-shadow:3px 3px 0 var(--key)}
</style>
